{
    "name": "dotkernel/dot-dependency-injection",
    "type": "library",
    "description": "Dotkernel dependency injection component using class attributes.",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-dependency-injection",
    "support": {
        "docs": "https://docs.dotkernel.org/dot-dependency-injection/",
        "issues": "https://github.com/dotkernel/dot-dependency-injection/issues"
    },
    "authors": [
        {
            "name": "DotKernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "keywords": [
        "attribute",
        "container",
        "dependency",
        "di",
        "factory",
        "inject",
        "service"
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "doctrine/orm": "^2.9 || ^3.0",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Dot\\DependencyInjection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\DependencyInjection\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "static-analysis": "phpstan analyse --memory-limit 1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
